{
  "schemaVersion": "1.0.0",
  "owner": "少爷 (Qiu1717)",
  "updatedAt": "2026-11-26T13:17:30+08:00",
  "defaultWorkspace": "E:\\Antigravtiy-workspace",
  "rulesRepository": "https://github.com/Qiu1717/MyAntigravity-rules.git",
  "globalRules": [
    {
      "sourceInRepo": "rules/AGENTS.md",
      "targets": [
        "~/.gemini/config/plugins/user-rules/rules/AGENTS.md",
        "~/.gemini/GEMINI.md"
      ]
    }
  ],
  "communityGitHubPlugins": [
    {
      "name": "agy-dart",
      "displayName": "agy-dart",
      "version": "1.7.2",
      "repository": "https://github.com/zou172866/Antigravity-agy-dart.git",
      "installDir": "~/.gemini/config/plugins/agy-dart",
      "installCommand": "git clone --depth 1 https://github.com/zou172866/Antigravity-agy-dart.git \"$env:TEMP\\agy-dart-src\"; node \"$env:TEMP\\agy-dart-src\\scripts\\install.mjs\" install --install-rg",
      "skills": ["agy-dart"],
      "mcpServers": ["agy-dart_fast", "agy-dart_context"],
      "hasRules": true,
      "hasHooks": true
    },
    {
      "name": "antigravity-context-monitor",
      "displayName": "Antigravity Context Monitor",
      "version": "1.17.6",
      "repository": "https://github.com/AGI-is-going-to-arrive/Antigravity-Context-Window-Monitor.git",
      "installDir": "~/.gemini/config/plugins/antigravity-context-monitor",
      "installCommand": "git clone https://github.com/AGI-is-going-to-arrive/Antigravity-Context-Window-Monitor.git \"$env:TEMP\\acm-src\"; node \"$env:TEMP\\acm-src\\scripts\\install-app-plugin.mjs\"",
      "skills": ["context-monitor"],
      "sidecars": ["antigravity-context-monitor/context_monitor"]
    },
    {
      "name": "antigravity-context-viewer",
      "displayName": "Antigravity 对话上下文查看器与 Token 看板",
      "version": "0.9.3",
      "repository": "https://github.com/elviscjn-cjn/antigravity-context-viewer.git",
      "installDir": "<workspace>/antigravity-context-viewer",
      "installCommand": "git clone --depth 1 https://github.com/elviscjn-cjn/antigravity-context-viewer.git \"<workspace>\\antigravity-context-viewer\"; node \"<workspace>\\antigravity-context-viewer\\cli.js\" install",
      "type": "asar-patcher"
    },
    {
      "name": "obsidian-prism",
      "displayName": "Obsidian Prism",
      "version": "1.0.8-beta.3",
      "repository": "https://github.com/RMvdesi/obsidian-prism.git",
      "installDir": "~/.gemini/config/plugins/obsidian-prism",
      "sourceDir": "<workspace>/obsidian-prism",
      "installCommand": "git clone https://github.com/RMvdesi/obsidian-prism.git \"<workspace>\\obsidian-prism\"; node \"<workspace>\\obsidian-prism\\tools\\install-plugin.cjs\" --install",
      "sidecars": ["obsidian-prism/daemon"],
      "type": "native-plugin"
    }
  ],
  "officialMarketplacePlugins": [
    {
      "name": "android-cli-plugin",
      "catalogId": "antigravity-plugins-official/plugin/android-cli-plugin",
      "version": "1.0.16625370",
